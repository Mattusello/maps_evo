# Copia questo file in `.env` e compila i valori. Le variabili con prefisso EXPO_PUBLIC_
# vengono incluse nel bundle a build time (non usarle per segreti server-side).

# Chiave Google Maps / Places (Fase 2). Necessaria per mappa e ricerca POI.
# Abilita: Maps SDK for Android, Maps SDK for iOS, Places API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend Laravel. Base URL dell'API, es. https://api.mymappa.app
# Il contratto che il server deve rispettare è in docs/BACKEND.md.
EXPO_PUBLIC_API_URL=

# Se "true", l'app abilita accesso e sincronizzazione con il backend.
# NON cambia dove vivono i dati: gli itinerari restano sul dispositivo e il SyncEngine
# li allinea al server, così l'app continua a funzionare senza rete.
EXPO_PUBLIC_USE_API=false
